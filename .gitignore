# ==========================
# SIH 26 Prototype .gitignore
# ==========================
__pycache__/
*.pyc
venv/
.env
# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Virtual environments
venv/
.venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Python environment

# ----- Node / Frontend -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
frontend/dist/
frontend/build/
.next/
out/

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ----- Database -----
*.db
*.sqlite3

# ----- Uploads (user uploaded documents) -----
uploads/

# ----- Model caches (PaddleOCR etc.) -----
.paddleocr/
~/.paddleocr/
paddle_models/
inference/
*.onnx
*.pdmodel
*.pdiparams

# ----- Secrets / Credentials -----
!.env.*.example
secrets/
*.pem
*.key

# ----- Logs -----
*.log
logs/

# ----- OS files -----
ehthumbs.db
$RECYCLE.BIN/

# ----- PDF Documents -----
*.pdf

# Explicit reference rulebook unignore for CI validation (Option B)
!docs/reference/AICTE_rulebook.pdf
# But do NOT commit the AICTE rulebook or any real institutional documents.

# ----- Misc -----
*.bak
*.tmp
*.temp
.cache/
