# SIH 2026 Prototype — Backend Configuration Template
# Copy this file to .env and adjust values for your environment.

# Database Connection
# PostgreSQL (Default):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sih_prototype
# SQLite fallback (optional, for lightweight local testing):
# DATABASE_URL=sqlite+aiosqlite:///./sih_prototype.db

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_PAGES=20

# Application Settings
API_PREFIX=/api
DEBUG=true

# CORS Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
