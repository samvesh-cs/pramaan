# SIH 2026 Prototype — Backend Configuration Template
# Copy this file to .env and adjust values for your environment.

# Database Connection
# SQLite (default, zero-setup, works immediately out of the box):
DATABASE_URL=sqlite+aiosqlite:///./sih_prototype.db
# PostgreSQL (optional, for production or team PostgreSQL setup):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sih_prototype

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_PAGES=20

# Application Settings
API_PREFIX=/api
DEBUG=true

# Authentication Settings
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true

# One-time Admin Setup Token (used to seed initial reviewer account)
ADMIN_SETUP_TOKEN=pramaan-admin-setup-secret-token-2026

# Seed Credentials (for development and demo)
REVIEWER_EMAIL=reviewer@aicte-india.org
REVIEWER_PASSWORD=Reviewer@AICTE2026
DEMO_INSTITUTION_EMAIL=institution@engg-college.edu.in
DEMO_INSTITUTION_PASSWORD=College@Pramaan2026

# CORS Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

